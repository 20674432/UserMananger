@model IEnumerable<UserCRUD.Models.User>

<h2>Users List</h2>
<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>ID Number</th>
            <th>Date of Birth</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.First_name</td>
                <td>@user.Last_name</td>
                <td>@user.Email</td>
                <td>@user.Id_number</td>
                <td>@user.Birth_date.ToString("yyyy-MM-dd")</td>
                <td>
                    <a href="@Url.Action("Delete", "Home", new { id = user.User_id })">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

